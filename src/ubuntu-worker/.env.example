# Copy to /home/suzukilab/study-timelapse-worker/config/worker.env (chmod 600).
# Never commit the filled-in version. No credential values belong in this file:
# authentication comes from ADC or GOOGLE_APPLICATION_CREDENTIALS.

# --- GCP ---
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
PUBSUB_SUBSCRIPTION_ID=study-timelapse-chunks-sub
# Authentication comes from ADC by default:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <project>
# Leave GOOGLE_APPLICATION_CREDENTIALS unset unless deliberately using a key
# file. Note that ADC from a human account grants the worker that account's
# permissions, including object deletion — see the security section of
# docs/ubuntu-vlm-llm-architecture.md.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Local layout ---
WORKER_ROOT=/home/suzukilab/study-timelapse-worker

# --- GPU assignment ---
# Verify with nvidia-smi before changing. The worker records GPU UUIDs and warns
# if the cards are renumbered across a reboot.
VLM_GPU=0
LLM_GPU=1

# --- Vision model (per 30s chunk) ---
# Interim model while Meta approval for Llama-3.2-11B-Vision is pending.
# Swap VLM_MODEL_ID to compare models on the same chunk — prompt text, output
# schema and validation are shared, so results are directly comparable.
VLM_MODEL_ID=google/gemma-3-12b-it
# auto | gemma3 | mllama. "auto" infers from the id and refuses to guess.
# PaliGemma is explicitly rejected rather than mis-routed to the Gemma 3 loader.
VLM_ARCHITECTURE=auto
# Pin a commit for reproducibility once the model is downloaded.
VLM_REVISION=
# Set from the benchmark result; do not guess.
VLM_PROFILE=original_8
VLM_SLO_MS=25000
VLM_MAX_NEW_TOKENS=512

# --- Aggregation model (per 30 min / session end) ---
LLM_MODEL_PATH=/home/suzukilab/study-timelapse-worker/models/Meta-Llama-3-70B-Instruct-Q2_K.gguf
LLM_REQUESTED_MODEL=Meta-Llama-3-70B-Instruct-Q2_K
LLM_CONTEXT_SIZE=8192
LLM_MAX_OUTPUT_TOKENS=1200
# Layers on GPU; the rest stay in the host's ~125GiB of RAM. Tune with the
# benchmark rather than trying to force the whole model onto one 24GB card.
LLM_GPU_LAYERS=20
LLM_BINARY=llama-cli

# --- Pipeline behaviour ---
WINDOW_MINUTES=30
MAX_ATTEMPTS=5
SESSION_END_GRACE_SEC=120
SPOOL_RETENTION_SEC=86400
# Loopback only. Never bind this to 0.0.0.0.
HEALTH_PORT=8799

# Set to 1 to run the whole pipeline with mock models (no GPU needed).
WORKER_DRY_RUN=0
